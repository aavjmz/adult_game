# 生产环境变量模板
#
# 用法：复制为 .env 并填入真实值。.env 已被 .gitignore 排除，
# 且本仓库是公开仓库 —— 切勿把真实 SECRET_KEY 提交进来。
#
#   cp .env.example .env
#   然后按下方说明生成 SECRET_KEY 填入

# Flask 会话签名密钥。缺失时 docker-compose 会直接拒绝启动
# （见 docker-compose.yml 中的 ${SECRET_KEY:?...}），这是刻意设计：
# 宁可起不来，也不要静默使用弱密钥让人伪造任意用户的会话。
#
# 生成方式：
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=

# 置于 nginx/Caddy 反代之后时设为 true，让 Flask 读取 X-Forwarded-*
# 还原真实客户端 IP 与协议。直连暴露时务必保持 false，否则等于
# 允许客户端任意伪造来源 IP。
BEHIND_PROXY=true

# 会话 Cookie 仅经 HTTPS 回传。仅在确实通过 HTTPS 访问时设为 true，
# 纯 HTTP 下开启会导致 Web 端登录后 Cookie 不回传、无限跳回登录页。
SESSION_COOKIE_SECURE=true

# gunicorn 进程/线程数（可选，默认 1 / 8）。
# worker 保持 1 是被 SQLite 约束：SQLite 同一时刻只允许一个写事务，
# 多进程并发写只会制造 "database is locked"。迁移到 PostgreSQL 后
# 可将 GUNICORN_WORKERS 提到 (2*CPU+1)。
#GUNICORN_WORKERS=1
#GUNICORN_THREADS=8
